{
  "name": "findly-api",
  "version": "1.0.0",
  "description": "Findly API - Local discovery platform backend",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "migrate": "node dist/main.js migrate",
    "test": "node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit"
