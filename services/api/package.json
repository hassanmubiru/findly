    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "streetjs": "^1.2.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
